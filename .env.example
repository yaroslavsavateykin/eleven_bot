# Docker image used by docker compose. Pin a release tag if needed, e.g. :v0.1.0.
ELEVEN_BOT_IMAGE=ghcr.io/yaroslavsavateykin/eleven_bot:latest

TELEGRAM_BOT_TOKEN=
# Required for /all. Create these at https://my.telegram.org/apps.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_GROUP_CHAT_ID=
TELEGRAM_DISCOVERY_MODE=false
GROUP_NAME=411 группа
GROUP_TIMEZONE=Europe/Moscow
# Optional academic-week reference. The date must be a Monday; parity is even or odd.
ACADEMIC_REFERENCE_WEEK_START=2026-09-07
ACADEMIC_REFERENCE_WEEK_PARITY=odd
DATABASE_PATH=/data/app.db
BASE_URL=http://localhost:6767
EXTERNAL_API_TOKEN=change-me
ADMIN_PASSWORD=change-this-to-a-long-random-password
ADMIN_TELEGRAM_USER_ID=
AI_BASE_URL=
AI_API_KEY=
AI_TEXT_MODEL=
AI_VISION_MODEL=
# Explicit OpenAI-compatible endpoint, credential and model for Telegram voice
# transcription. Empty API/key values inherit AI_BASE_URL and AI_API_KEY.
AI_STT_BASE_URL=
AI_STT_API_KEY=
AI_STT_MODEL=
# Optional dedicated private Whisper service for Telegram voice messages.
# When set, ElevenBot uses WHISPER_BASE_URL/inference instead of the AI
# gateway /audio/transcriptions endpoint. Keep this server-side only.
WHISPER_BASE_URL=
WHISPER_API_KEY=
RAW_MESSAGE_RETENTION_HOURS=48
HTTP_ADDR=:6767
GITHUB_REPOSITORY=yaroslavsavateykin/eleven_bot
AI_TOOL_MODE=native
# Optional direct provider route for agent runs, avoiding round-robin combos.
AI_AGENT_MODEL=
AI_STRICT_TOOLS=false
AI_DISABLE_PARALLEL_TOOLS=false
AI_CONTEXT_BYTES=131072
